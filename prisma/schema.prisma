generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  name String
  username String? @unique
  email String @unique
  passwordHash String
  role String @default("VIEWER")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audits Audit[]
}
model Assignment {
  id String @id @default(cuid())
  room Int
  weekday Int?
  date DateTime?
  scope String
  shift String
  status String @default("LIVRE")
  professional String?
  code String?
  specialty String?
  operator String?
  notes String?
  rawText String?
  needsReview Boolean @default(false)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  updatedById String?
  @@unique([room, weekday, scope, shift])
  @@index([date, room, shift])
}
model Audit {
  id String @id @default(cuid())
  assignmentId String?
  userId String?
  room Int?
  weekday Int?
  date DateTime?
  scope String?
  shift String?
  action String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  user User? @relation(fields:[userId], references:[id], onDelete: SetNull)
  @@index([createdAt])
}
